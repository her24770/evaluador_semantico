# Backend: /api/chat (tutor) y /api/leer-foto. Node sin dependencias de producción.
FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3001
COPY package.json ./
COPY api ./api
COPY src ./src
COPY scripts/servidor-asistente.js ./scripts/
# Solo la teoría que lee el tutor; los PDF no se incluyen.
COPY teoria/fuentes.json teoria/*.md ./teoria/
USER node
EXPOSE 3001
CMD ["node", "scripts/servidor-asistente.js"]
