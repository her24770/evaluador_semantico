{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/chat.js": {
      "maxDuration": 30,
      "includeFiles": "teoria/{fuentes.json,*.md}",
      "excludeFiles": "teoria/pdf/**"
    },
    "api/leer-foto.js": {
      "maxDuration": 30
    }
  }
}
